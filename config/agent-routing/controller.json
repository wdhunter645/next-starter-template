{
  "schemaVersion": 1,
  "repository": "wdhunter645/next-starter-template",
  "mode": "observe-only",
  "mutationAllowed": false,
  "canonicalEventMarkers": [
    "IMPLEMENTATION HANDOFF",
    "PR REVIEW REQUEST"
  ],
  "legacyAdapterMarkers": [
    "CHATGPT HANDOFF"
  ],
  "labelsAreAuthority": false,
  "requireOpenSourceIssue": true,
  "requireExactSourceIssueCount": 1,
  "rereadBeforePacket": true,
  "rejectStaleHeadSha": true,
  "protectedDecisionClasses": [
    "product",
    "design",
    "engineering-approval",
    "recovery",
    "credential",
    "secret",
    "destructive",
    "rights-privacy-publication",
    "production"
  ],
  "remediationRouting": {
    "enabled": true,
    "sourceIssueOnly": true,
    "responseMarker": "ADJUSTMENT",
    "resumeMarker": "LOCAL CURSOR RESUME",
    "escalationMarker": "HOLD",
    "requiredChecks": [
      "quality"
    ],
    "trustedDecisionAuthors": [
      "wdhunter645"
    ],
    "trustedControllerAuthors": [
      "wdhunter645",
      "github-actions[bot]"
    ],
    "capabilities": {
      "response": true,
      "resume": true,
      "escalation": true
    }
  },
  "componentIntegration": {
    "enabled": true,
    "allowedTargets": [
      "component/deterministic-handoff-controller"
    ],
    "allowedTargetPrefixes": [
      "component/"
    ],
    "forbiddenTargets": [
      "main",
      "master",
      "production",
      "prod"
    ],
    "requiredChecks": [
      "quality"
    ],
    "allowedApprovalProfiles": [
      "component-auto-integration",
      "protected-change-review"
    ],
    "deterministicApprovalProfiles": [
      "component-auto-integration"
    ],
    "mergeMethod": "squash",
    "sourceIssueMustRemainOpen": true,
    "verifyAfterMerge": true,
    "maxMutationsPerRun": 1
  },
  "idempotency": {
    "keyFields": [
      "sourceIssueNumber",
      "eventType",
      "eventCommentId",
      "prNumber",
      "headSha",
      "actionIdentity",
      "findingIdentity",
      "dispositionRevision",
      "resumeIdentity",
      "targetBranch",
      "mergeSha"
    ]
  },
  "workflowCapabilities": {
    "merge": false,
    "close": false,
    "relabel": false,
    "resume": false,
    "activateSuccessor": false,
    "mutateMain": false
  }
}

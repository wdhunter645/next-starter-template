{
  "schemaVersion": 1,
  "repository": "wdhunter645/next-starter-template",
  "mode": "observe-only",
  "mutationAllowed": false,
  "canonicalEventMarkers": [
    "IMPLEMENTATION HANDOFF",
    "PR REVIEW REQUEST"
  ],
  "legacyAdapterMarkers": [
    "CHATGPT HANDOFF"
  ],
  "labelsAreAuthority": false,
  "requireOpenSourceIssue": true,
  "requireExactSourceIssueCount": 1,
  "rereadBeforePacket": true,
  "rejectStaleHeadSha": true,
  "protectedDecisionClasses": [
    "product",
    "design",
    "engineering-approval",
    "recovery",
    "credential",
    "secret",
    "destructive",
    "rights-privacy-publication",
    "production"
  ],
  "mutationSwitches": {
    "remediationInstructions": true,
    "componentIntegration": true,
    "closeoutSuccessor": true,
    "reconciliationMutations": false
  },
  "observability": {
    "enabled": true,
    "schemaVersion": 1
  },
  "reconciliation": {
    "enabled": true,
    "role": "safety-net",
    "primaryPath": "event-driven",
    "mutationAllowed": false,
    "maxCandidatesPerRun": 1,
    "detectMissedEligible": true,
    "detectStaleEligible": true,
    "staleEligibleAfterMinutes": 45
  },
  "remediationRouting": {
    "enabled": true,
    "sourceIssueOnly": true,
    "responseMarker": "ADJUSTMENT",
    "resumeMarker": "LOCAL CURSOR RESUME",
    "escalationMarker": "HOLD",
    "requiredChecks": [
      "quality"
    ],
    "trustedDecisionAuthors": [
      "wdhunter645"
    ],
    "trustedControllerAuthors": [
      "wdhunter645",
      "github-actions[bot]"
    ],
    "capabilities": {
      "response": true,
      "resume": true,
      "escalation": true
    }
  },
  "componentIntegration": {
    "enabled": true,
    "allowMain": false,
    "allowProduction": false,
    "allowedTargetPrefixes": [
      "component/"
    ],
    "deterministicApprovalProfiles": [
      "component-auto-integration"
    ],
    "independentReviewApprovalProfiles": [
      "protected-change-review"
    ],
    "mergeMethod": "squash",
    "maxIntegrationsPerRun": 1,
    "requiredChecks": [
      "quality"
    ],
    "trustedReviewAuthors": [
      "chatgpt-atlas",
      "wdhunter645"
    ],
    "trustedIntegrationAuthorizationAuthors": [
      "chatgpt-atlas",
      "wdhunter645"
    ],
    "capabilities": {
      "integrate": true,
      "verify": true,
      "close": false,
      "activateSuccessor": false
    }
  },
  "closeoutSuccessor": {
    "enabled": true,
    "allowMain": false,
    "allowProduction": false,
    "maxTransactionsPerRun": 1,
    "trustedDecisionAuthors": [
      "wdhunter645"
    ],
    "trustedControllerAuthors": [
      "wdhunter645",
      "github-actions[bot]"
    ],
    "resumeMarker": "LOCAL CURSOR RESUME",
    "capabilities": {
      "close": true,
      "reportParent": true,
      "activateSuccessor": true,
      "resume": true,
      "merge": false,
      "mutateMain": false
    }
  },
  "idempotency": {
    "keyFields": [
      "sourceIssueNumber",
      "eventType",
      "eventCommentId",
      "prNumber",
      "headSha",
      "actionIdentity",
      "findingIdentity",
      "dispositionRevision",
      "resumeIdentity",
      "targetBranch",
      "integrationDisposition",
      "mergeSha",
      "verificationIdentity",
      "closeoutIdentity",
      "parentReportIdentity",
      "successorIdentity",
      "reconciliationIdentity"
    ]
  },
  "workflowCapabilities": {
    "merge": false,
    "close": false,
    "relabel": false,
    "resume": false,
    "activateSuccessor": false,
    "mutateMain": false
  }
}

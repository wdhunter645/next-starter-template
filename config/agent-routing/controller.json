{
  "schemaVersion": 1,
  "repository": "wdhunter645/next-starter-template",
  "mode": "observe-only",
  "mutationAllowed": false,
  "canonicalEventMarkers": [
    "IMPLEMENTATION HANDOFF",
    "PR REVIEW REQUEST"
  ],
  "legacyAdapterMarkers": [
    "CHATGPT HANDOFF"
  ],
  "labelsAreAuthority": false,
  "requireOpenSourceIssue": true,
  "requireExactSourceIssueCount": 1,
  "rereadBeforePacket": true,
  "rejectStaleHeadSha": true,
  "protectedDecisionClasses": [
    "product",
    "design",
    "engineering-approval",
    "recovery",
    "credential",
    "secret",
    "destructive",
    "rights-privacy-publication",
    "production"
  ],
  "remediationRouting": {
    "enabled": true,
    "sourceIssueOnly": true,
    "responseMarker": "ADJUSTMENT",
    "resumeMarker": "LOCAL CURSOR RESUME",
    "escalationMarker": "HOLD",
    "requiredChecks": [
      "quality"
    ],
    "trustedDecisionAuthors": [
      "wdhunter645"
    ],
    "trustedControllerAuthors": [
      "wdhunter645",
      "github-actions[bot]"
    ],
    "capabilities": {
      "response": true,
      "resume": true,
      "escalation": true
    }
  },
  "componentIntegration": {
    "enabled": true,
    "allowMain": false,
    "allowProduction": false,
    "allowedTargetPrefixes": [
      "component/"
    ],
    "deterministicApprovalProfiles": [
      "component-auto-integration"
    ],
    "independentReviewApprovalProfiles": [
      "protected-change-review"
    ],
    "trustedIntegrationDecisionAuthors": [
      "wdhunter645"
    ],
    "trustedReviewAuthors": [
      "chatgpt-atlas",
      "copilot-pull-request-reviewer[bot]"
    ],
    "mergeMethod": "squash",
    "maxIntegrationsPerRun": 1,
    "requiredChecks": [
      "quality"
    ],
    "capabilities": {
      "integrate": true,
      "verify": true,
      "close": false,
      "activateSuccessor": false
    }
  },
  "idempotency": {
    "keyFields": [
      "sourceIssueNumber",
      "eventType",
      "eventCommentId",
      "prNumber",
      "headSha",
      "actionIdentity",
      "findingIdentity",
      "dispositionRevision",
      "resumeIdentity",
      "targetBranch",
      "integrationDisposition",
      "mergeSha",
      "verificationIdentity"
    ]
  },
  "workflowCapabilities": {
    "merge": false,
    "close": false,
    "relabel": false,
    "resume": false,
    "activateSuccessor": false,
    "mutateMain": false
  }
}

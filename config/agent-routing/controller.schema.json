{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wdhunter645/next-starter-template/config/agent-routing/controller.schema.json",
  "title": "LGFC deterministic handoff controller configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "mode",
    "mutationAllowed",
    "canonicalEventMarkers",
    "legacyAdapterMarkers",
    "protectedDecisionClasses",
    "mutationSwitches",
    "observability",
    "reconciliation",
    "remediationRouting",
    "componentIntegration",
    "closeoutSuccessor",
    "idempotency",
    "workflowCapabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repository": { "type": "string", "minLength": 3 },
    "mode": { "type": "string", "enum": ["observe-only"] },
    "mutationAllowed": { "type": "boolean", "const": false },
    "canonicalEventMarkers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "legacyAdapterMarkers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "labelsAreAuthority": { "type": "boolean", "const": false },
    "requireOpenSourceIssue": { "type": "boolean", "const": true },
    "requireExactSourceIssueCount": { "type": "integer", "const": 1 },
    "rereadBeforePacket": { "type": "boolean", "const": true },
    "rejectStaleHeadSha": { "type": "boolean", "const": true },
    "protectedDecisionClasses": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product",
          "design",
          "engineering-approval",
          "recovery",
          "credential",
          "secret",
          "destructive",
          "rights-privacy-publication",
          "production"
        ]
      }
    },
    "mutationSwitches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remediationInstructions",
        "componentIntegration",
        "closeoutSuccessor",
        "reconciliationMutations"
      ],
      "properties": {
        "remediationInstructions": { "type": "boolean" },
        "componentIntegration": { "type": "boolean" },
        "closeoutSuccessor": { "type": "boolean" },
        "reconciliationMutations": { "type": "boolean", "const": false }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schemaVersion"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schemaVersion": { "type": "integer", "const": 1 }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "role",
        "primaryPath",
        "mutationAllowed",
        "maxCandidatesPerRun",
        "detectMissedEligible",
        "detectStaleEligible",
        "staleEligibleAfterMinutes"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "role": { "type": "string", "const": "safety-net" },
        "primaryPath": { "type": "string", "const": "event-driven" },
        "mutationAllowed": { "type": "boolean", "const": false },
        "maxCandidatesPerRun": { "type": "integer", "const": 1 },
        "detectMissedEligible": { "type": "boolean" },
        "detectStaleEligible": { "type": "boolean" },
        "staleEligibleAfterMinutes": { "type": "integer", "minimum": 1 }
      }
    },
    "remediationRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sourceIssueOnly",
        "responseMarker",
        "resumeMarker",
        "escalationMarker",
        "requiredChecks",
        "trustedDecisionAuthors",
        "trustedControllerAuthors",
        "capabilities"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceIssueOnly": { "type": "boolean", "const": true },
        "responseMarker": { "type": "string", "const": "ADJUSTMENT" },
        "resumeMarker": { "type": "string", "const": "LOCAL CURSOR RESUME" },
        "escalationMarker": { "type": "string", "const": "HOLD" },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedDecisionAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedControllerAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["response", "resume", "escalation"],
          "properties": {
            "response": { "type": "boolean", "const": true },
            "resume": { "type": "boolean", "const": true },
            "escalation": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "componentIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowMain",
        "allowProduction",
        "allowedTargetPrefixes",
        "deterministicApprovalProfiles",
        "independentReviewApprovalProfiles",
        "mergeMethod",
        "maxIntegrationsPerRun",
        "requiredChecks",
        "trustedReviewAuthors",
        "trustedIntegrationAuthorizationAuthors",
        "capabilities"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowMain": { "type": "boolean", "const": false },
        "allowProduction": { "type": "boolean", "const": false },
        "allowedTargetPrefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^component/" }
        },
        "deterministicApprovalProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "const": "component-auto-integration" }
        },
        "independentReviewApprovalProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "const": "protected-change-review" }
        },
        "mergeMethod": { "type": "string", "enum": ["squash", "merge", "rebase"] },
        "maxIntegrationsPerRun": { "type": "integer", "const": 1 },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedReviewAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedIntegrationAuthorizationAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrate", "verify", "close", "activateSuccessor"],
          "properties": {
            "integrate": { "type": "boolean", "const": true },
            "verify": { "type": "boolean", "const": true },
            "close": { "type": "boolean", "const": false },
            "activateSuccessor": { "type": "boolean", "const": false }
          }
        }
      }
    },
    "closeoutSuccessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowMain",
        "allowProduction",
        "maxTransactionsPerRun",
        "trustedDecisionAuthors",
        "trustedControllerAuthors",
        "resumeMarker",
        "capabilities"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowMain": { "type": "boolean", "const": false },
        "allowProduction": { "type": "boolean", "const": false },
        "maxTransactionsPerRun": { "type": "integer", "const": 1 },
        "trustedDecisionAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedControllerAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resumeMarker": { "type": "string", "const": "LOCAL CURSOR RESUME" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "close",
            "reportParent",
            "activateSuccessor",
            "resume",
            "merge",
            "mutateMain"
          ],
          "properties": {
            "close": { "type": "boolean", "const": true },
            "reportParent": { "type": "boolean", "const": true },
            "activateSuccessor": { "type": "boolean", "const": true },
            "resume": { "type": "boolean", "const": true },
            "merge": { "type": "boolean", "const": false },
            "mutateMain": { "type": "boolean", "const": false }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "required": ["keyFields"],
      "additionalProperties": false,
      "properties": {
        "keyFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sourceIssueNumber",
              "eventType",
              "eventCommentId",
              "prNumber",
              "headSha",
              "actionIdentity",
              "findingIdentity",
              "dispositionRevision",
              "resumeIdentity",
              "targetBranch",
              "integrationDisposition",
              "mergeSha",
              "verificationIdentity",
              "closeoutIdentity",
              "parentReportIdentity",
              "successorIdentity",
              "reconciliationIdentity"
            ]
          }
        }
      }
    },
    "workflowCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "close", "relabel", "resume", "activateSuccessor", "mutateMain"],
      "properties": {
        "merge": { "type": "boolean", "const": false },
        "close": { "type": "boolean", "const": false },
        "relabel": { "type": "boolean", "const": false },
        "resume": { "type": "boolean", "const": false },
        "activateSuccessor": { "type": "boolean", "const": false },
        "mutateMain": { "type": "boolean", "const": false }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wdhunter645/next-starter-template/config/agent-routing/controller.schema.json",
  "title": "LGFC deterministic handoff controller configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "mode",
    "mutationAllowed",
    "canonicalEventMarkers",
    "legacyAdapterMarkers",
    "protectedDecisionClasses",
    "remediationRouting",
    "idempotency"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "mode": {
      "type": "string",
      "enum": ["observe-only"]
    },
    "mutationAllowed": {
      "type": "boolean",
      "const": false
    },
    "canonicalEventMarkers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legacyAdapterMarkers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labelsAreAuthority": {
      "type": "boolean",
      "const": false
    },
    "requireOpenSourceIssue": {
      "type": "boolean",
      "const": true
    },
    "requireExactSourceIssueCount": {
      "type": "integer",
      "const": 1
    },
    "rereadBeforePacket": {
      "type": "boolean",
      "const": true
    },
    "rejectStaleHeadSha": {
      "type": "boolean",
      "const": true
    },
    "protectedDecisionClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "product",
          "engineering-approval",
          "recovery",
          "credential",
          "destructive",
          "production"
        ]
      }
    },
    "remediationRouting": {
      "type": "object",
      "required": [
        "enabled",
        "sourceIssueOnly",
        "responseMarker",
        "resumeMarker",
        "escalationMarker",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceIssueOnly": { "type": "boolean", "const": true },
        "responseMarker": { "type": "string", "const": "ADJUSTMENT" },
        "resumeMarker": { "type": "string", "const": "LOCAL CURSOR RESUME" },
        "escalationMarker": { "type": "string", "const": "HOLD" },
        "capabilities": {
          "type": "object",
          "required": ["response", "resume", "escalation"],
          "additionalProperties": false,
          "properties": {
            "response": { "type": "boolean", "const": true },
            "resume": { "type": "boolean", "const": true },
            "escalation": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "required": ["keyFields"],
      "additionalProperties": false,
      "properties": {
        "keyFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "sourceIssueNumber",
              "eventType",
              "eventCommentId",
              "prNumber",
              "headSha",
              "actionIdentity",
              "findingIdentity",
              "dispositionRevision",
              "resumeIdentity"
            ]
          }
        }
      }
    },
    "workflowCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merge": { "type": "boolean", "const": false },
        "close": { "type": "boolean", "const": false },
        "relabel": { "type": "boolean", "const": false },
        "resume": { "type": "boolean", "const": false },
        "activateSuccessor": { "type": "boolean", "const": false },
        "mutateMain": { "type": "boolean", "const": false }
      }
    }
  }
}

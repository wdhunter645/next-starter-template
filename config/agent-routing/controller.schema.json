{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wdhunter645/next-starter-template/config/agent-routing/controller.schema.json",
  "title": "LGFC deterministic handoff controller configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "mode",
    "mutationAllowed",
    "canonicalEventMarkers",
    "legacyAdapterMarkers",
    "protectedDecisionClasses",
    "remediationRouting",
    "componentIntegration",
    "idempotency",
    "workflowCapabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "mode": {
      "type": "string",
      "enum": [
        "observe-only"
      ]
    },
    "mutationAllowed": {
      "type": "boolean",
      "const": false
    },
    "canonicalEventMarkers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legacyAdapterMarkers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labelsAreAuthority": {
      "type": "boolean",
      "const": false
    },
    "requireOpenSourceIssue": {
      "type": "boolean",
      "const": true
    },
    "requireExactSourceIssueCount": {
      "type": "integer",
      "const": 1
    },
    "rereadBeforePacket": {
      "type": "boolean",
      "const": true
    },
    "rejectStaleHeadSha": {
      "type": "boolean",
      "const": true
    },
    "protectedDecisionClasses": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product",
          "design",
          "engineering-approval",
          "recovery",
          "credential",
          "secret",
          "destructive",
          "rights-privacy-publication",
          "production"
        ]
      }
    },
    "remediationRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sourceIssueOnly",
        "responseMarker",
        "resumeMarker",
        "escalationMarker",
        "requiredChecks",
        "trustedDecisionAuthors",
        "trustedControllerAuthors",
        "capabilities"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "sourceIssueOnly": {
          "type": "boolean",
          "const": true
        },
        "responseMarker": {
          "type": "string",
          "const": "ADJUSTMENT"
        },
        "resumeMarker": {
          "type": "string",
          "const": "LOCAL CURSOR RESUME"
        },
        "escalationMarker": {
          "type": "string",
          "const": "HOLD"
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trustedDecisionAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trustedControllerAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "response",
            "resume",
            "escalation"
          ],
          "properties": {
            "response": {
              "type": "boolean",
              "const": true
            },
            "resume": {
              "type": "boolean",
              "const": true
            },
            "escalation": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "componentIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowMain",
        "allowProduction",
        "allowedTargetPrefixes",
        "deterministicApprovalProfiles",
        "independentReviewApprovalProfiles",
        "trustedReviewAuthors",
        "trustedIntegrationAuthors",
        "mergeMethod",
        "maxIntegrationsPerRun",
        "requiredChecks",
        "capabilities"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowMain": {
          "type": "boolean",
          "const": false
        },
        "allowProduction": {
          "type": "boolean",
          "const": false
        },
        "allowedTargetPrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^component/"
          }
        },
        "deterministicApprovalProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "const": "component-auto-integration"
          }
        },
        "independentReviewApprovalProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "const": "protected-change-review"
          }
        },
        "trustedReviewAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trustedIntegrationAuthors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mergeMethod": {
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        },
        "maxIntegrationsPerRun": {
          "type": "integer",
          "const": 1
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integrate",
            "verify",
            "close",
            "activateSuccessor"
          ],
          "properties": {
            "integrate": {
              "type": "boolean",
              "const": true
            },
            "verify": {
              "type": "boolean",
              "const": true
            },
            "close": {
              "type": "boolean",
              "const": false
            },
            "activateSuccessor": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "required": [
        "keyFields"
      ],
      "additionalProperties": false,
      "properties": {
        "keyFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sourceIssueNumber",
              "eventType",
              "eventCommentId",
              "prNumber",
              "headSha",
              "actionIdentity",
              "findingIdentity",
              "dispositionRevision",
              "resumeIdentity",
              "targetBranch",
              "integrationDisposition",
              "mergeSha",
              "verificationIdentity"
            ]
          }
        }
      }
    },
    "workflowCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge",
        "close",
        "relabel",
        "resume",
        "activateSuccessor",
        "mutateMain"
      ],
      "properties": {
        "merge": {
          "type": "boolean",
          "const": false
        },
        "close": {
          "type": "boolean",
          "const": false
        },
        "relabel": {
          "type": "boolean",
          "const": false
        },
        "resume": {
          "type": "boolean",
          "const": false
        },
        "activateSuccessor": {
          "type": "boolean",
          "const": false
        },
        "mutateMain": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}

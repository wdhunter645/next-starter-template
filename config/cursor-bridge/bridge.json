{
  "schemaVersion": 1,
  "repository": "wdhunter645/next-starter-template",
  "workspacePathEnv": "LGFC_CURSOR_BRIDGE_WORKSPACE",
  "defaultWorkspaceHint": "next-starter-template/next-starter-template",
  "queueDir": "queue",
  "consumedDir": "consumed",
  "claimPath": "claim.json",
  "alertsLog": "alerts.log",
  "bridgeLog": "bridge.log",
  "claimTtlSeconds": 7200,
  "reconcileIntervalSeconds": 900,
  "requiredLabels": ["agent:cursor", "handoff:ready"],
  "responseMarker": "CHATGPT RESPONSE",
  "resumeMarker": "LOCAL CURSOR RESUME",
  "fallbackCommentPrefix": "CURSOR BRIDGE FALLBACK: unclaimed",
  "ackCommentPrefix": "CURSOR BRIDGE ACK: delivered",
  "startedCommentPrefix": "CURSOR BRIDGE STARTED",
  "completedCommentPrefix": "CURSOR BRIDGE COMPLETED",
  "cliBinaryCandidates": ["agent", "cursor"],
  "cliLaunchMode": "print",
  "prohibitYolo": true,
  "prohibitCloudHandoff": true
}

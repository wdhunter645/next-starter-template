{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wdhunter645/next-starter-template/schemas/cumulative-lane-evidence/v1/event.schema.json",
  "title": "LGFC cumulative lane evidence event v1",
  "description": "Append-only, versioned evidence event for Sandbox → Development → Promotion Candidate → Production closeout. Canonical history lives as marked Issue comments; this schema validates the payload. See docs/reference/operations/cumulative-lane-evidence-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "sourceIssue",
    "workUnitId",
    "lane",
    "transition",
    "actorRole",
    "timestamp",
    "result",
    "evidenceRefs",
    "protectedStops",
    "laneFields"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "lgfc-cumulative-evidence:v1"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Stable unique key for duplicate suppression. Controllers must ignore later events with the same key."
    },
    "sourceIssue": {
      "type": "integer",
      "minimum": 1,
      "description": "Primary source task Issue number."
    },
    "workUnitId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable work-unit identity (for example parent-child task id or release-unit id)."
    },
    "lane": {
      "type": "string",
      "enum": ["sandbox", "development", "promotion_candidate", "production"]
    },
    "transition": {
      "type": "string",
      "enum": [
        "enter",
        "progress",
        "exit",
        "correct",
        "hold",
        "resume",
        "return_to_development",
        "closeout"
      ]
    },
    "candidateSha": {
      "type": ["string", "null"],
      "pattern": "^([0-9a-f]{40})?$",
      "description": "Exact candidate SHA when the event binds to an integrated candidate. Required for promotion_candidate exit and all production transitions."
    },
    "actorRole": {
      "type": "string",
      "enum": [
        "product_authority",
        "pmo_engineering",
        "implementation_operations",
        "pr_approver_engineering",
        "administration_communications",
        "day2_operations",
        "deterministic_ci"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable actor label (role holder or automation identity)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "deferred", "superseded"]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "issue",
              "pr",
              "check_run",
              "workflow_run",
              "commit",
              "comment",
              "document",
              "artifact",
              "deployment",
              "other"
            ]
          },
          "uri": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "supersedes": {
      "type": ["string", "null"],
      "description": "idempotencyKey of the event this correction supersedes. Null when not a correction."
    },
    "protectedStops": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "materialDesignDecision",
          "authorityConflict",
          "unsafePreviewIsolation",
          "credentialsCostBusinessAuth",
          "structuralDesignFailure",
          "incompleteLaunchPackage",
          "scopeOrAllowlistConflict",
          "requiredGateFailure",
          "blockingReviewThreads",
          "explicitHoldInstruction",
          "closeoutEvidenceConflict"
        ]
      },
      "description": "Protected-stop flags from docs/reference/agents/implementation-authority-contract.md. Non-empty requires stop and escalation; lane exit must fail closed."
    },
    "nextExpectedTransition": {
      "type": ["string", "null"],
      "enum": [
        "enter",
        "progress",
        "exit",
        "correct",
        "hold",
        "resume",
        "return_to_development",
        "closeout",
        null
      ]
    },
    "summary": {
      "type": "string",
      "description": "Short human-readable disposition."
    },
    "laneFields": {
      "type": "object",
      "description": "Lane-required fields. Validators enforce the matrix in the contract document by lane + transition.",
      "additionalProperties": true
    }
  }
}

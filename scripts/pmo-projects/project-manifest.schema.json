{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lougehrigfanclub.com/schemas/pmo-project-manifest.v1.json",
  "title": "LGFC PMO Project Delivery Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "roles",
    "delivery",
    "launch",
    "deliverables",
    "tasks",
    "validation",
    "closeout"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueNumber",
        "slug",
        "title",
        "parentIssueNumber",
        "lifecycle",
        "priorityLabel",
        "objective",
        "completedDeliverable",
        "designPath",
        "implementationPlanPath",
        "manifestPath"
      ],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "parentIssueNumber": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "lifecycle": { "enum": ["pipeline", "active", "closed"] },
        "priorityLabel": { "type": "string", "pattern": "^pmo:priority:" },
        "objective": { "type": "string", "minLength": 1 },
        "completedDeliverable": { "type": "string", "minLength": 1 },
        "designPath": { "type": "string", "minLength": 1 },
        "implementationPlanPath": { "type": "string", "minLength": 1 },
        "manifestPath": { "type": "string", "minLength": 1 }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparationOwner",
        "executionAgent",
        "operationsOwner",
        "tier2Escalation",
        "productAuthority",
        "productionApprovers"
      ],
      "properties": {
        "preparationOwner": { "type": "string", "minLength": 1 },
        "executionAgent": { "type": "string", "minLength": 1 },
        "operationsOwner": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tier2Escalation": { "type": "string", "minLength": 1 },
        "productAuthority": { "type": "string", "minLength": 1 },
        "productionApprovers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "model",
        "projectBranch",
        "productionBase",
        "autoIntegrateNonMain",
        "autoMergeProduction",
        "childPullRequestBase",
        "promotionPullRequestBase",
        "promotionApproval",
        "rollbackProfile"
      ],
      "properties": {
        "model": { "enum": ["A", "B"] },
        "projectBranch": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "upstreamDependencyBranch": { "type": "string" },
        "productionBase": { "type": "string", "minLength": 1 },
        "autoIntegrateNonMain": { "type": "boolean" },
        "autoMergeProduction": { "const": false },
        "childPullRequestBase": { "type": "string", "minLength": 1 },
        "promotionPullRequestBase": { "type": "string", "minLength": 1 },
        "promotionApproval": { "const": "bill-or-chatgpt" },
        "rollbackProfile": { "type": "string", "minLength": 1 }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "authorizationIssueNumber",
        "startConditions",
        "blockingConditions",
        "continuousExecution",
        "requiresNewPromptBetweenTasks"
      ],
      "properties": {
        "state": { "enum": ["prepared", "launched", "held", "complete"] },
        "authorizationIssueNumber": { "type": "integer", "minimum": 1 },
        "startConditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blockingConditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "continuousExecution": { "type": "boolean" },
        "requiresNewPromptBetweenTasks": { "type": "boolean" }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "description",
          "required",
          "acceptanceEvidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "runtime",
              "documentation",
              "test-evidence",
              "operations",
              "closeout"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "acceptanceEvidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "state",
          "predecessors",
          "successors",
          "parallelGroup",
          "branchPattern",
          "pullRequestBase",
          "allowedPaths",
          "prohibitedPaths",
          "acceptanceCriteria",
          "verification",
          "stopConditions",
          "labels",
          "wakeEligible"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "issueNumber": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "state": { "enum": ["active", "prepared", "held", "complete"] },
          "predecessors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "successors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parallelGroup": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "branchPattern": { "type": "string", "minLength": 1 },
          "pullRequestBase": { "type": "string", "minLength": 1 },
          "allowedPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prohibitedPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "stopConditions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "labels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "wakeEligible": { "type": "boolean" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestCommand",
        "materializeDryRunCommand",
        "requiredProfiles",
        "projectIntegrationChecks",
        "productionPromotionChecks"
      ],
      "properties": {
        "manifestCommand": { "type": "string", "minLength": 1 },
        "materializeDryRunCommand": { "type": "string", "minLength": 1 },
        "requiredProfiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "projectIntegrationChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "productionPromotionChecks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalTaskId",
        "finalReview",
        "productionVerificationRequired",
        "operationsOwner",
        "tier2Escalation",
        "rollbackReference"
      ],
      "properties": {
        "terminalTaskId": { "type": "string", "minLength": 1 },
        "finalReview": { "const": "bill-or-chatgpt" },
        "productionVerificationRequired": { "type": "boolean" },
        "operationsOwner": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tier2Escalation": { "type": "string", "minLength": 1 },
        "rollbackReference": { "type": "string", "minLength": 1 }
      }
    }
  }
}

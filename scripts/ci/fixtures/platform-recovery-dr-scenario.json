    "mustExclude": ["api_token", "app_key", "password", "secret_value"]
  },
  "monitoring": {
    "observationWindow": "synthetic-15m",
    "successCriteria": [
      "rollback_target_identity_stable",
      "nested_d1_b2_isolation_ok",
      "return_to_service_checks_pass",
      "cleanup_complete"
    ]

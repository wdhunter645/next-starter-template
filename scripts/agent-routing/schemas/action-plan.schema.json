{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Routing Action Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionKey",
    "class",
    "reason",
    "expectedRevision",
    "mutations"
  ],
  "properties": {
    "actionKey": {
      "type": "string"
    },
    "class": {
      "enum": [
        "halt",
        "noop",
        "observe",
        "cursor_ack_required",
        "ci_failure_disposition",
        "integrate_non_main",
        "chatgpt_review",
        "human_decision",
        "nested_pr_review",
        "nested_review_remediation",
        "plan_adjustment_route",
        "operational_assessment",
        "operational_auto_remediation",
        "operational_incident_route",
        "operational_hold_release"
      ]
    },
    "reason": {
      "type": "string"
    },
    "expectedRevision": {
      "type": "string"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subject": {
      "type": "object"
    }
  }
}

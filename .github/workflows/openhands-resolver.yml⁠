name: OpenHands Agent Resolver

on:
  issues:
    types: [labeled]
  issue_comment:
    types: [created]

permissions:
  contents: write
  issues: write
  pull-requests: write

jobs:
  run-openhands:
    if: >
      github.event.label.name == 'openhands' ||
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@openhands-agent'))
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Trigger OpenHands Cloud Execution
        env:
          OPENHANDS_API_KEY: ${{ secrets.OPENHANDS_API_KEY }}
          REPO_NAME: ${{ github.repository }}
          ISSUE_NUMBER: ${{ github.event.issue.number }}
          INSTRUCTION: ${{ github.event.comment.body || github.event.issue.body }}
        run: |
          echo "Triggering OpenHands for issue #${ISSUE_NUMBER} on ${REPO_NAME}..."
          
          curl -X POST "https://app.all-hands.dev/api/conversations" \
            -H "Authorization: Bearer ${OPENHANDS_API_KEY}" \
            -H "Content-Type: application/json" \
            -d $(jq -n \
              --arg repo "$REPO_NAME" \
              --arg issue "$ISSUE_NUMBER" \
              --arg instruction "$INSTRUCTION" \
              '{
                repository: $repo,
                issue_number: ($issue | tonumber),
                instruction: $instruction
              }')
